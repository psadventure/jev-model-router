# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Master switch. Anything other than "true" disables routing (default model: sonnet).
JEV_ROUTER_ENABLED=false

# Option A: call TypeSafe directly
TYPESAFE_API_KEY=

# Option B: call via OpenRouter (takes priority when set)
OPENROUTER_API_KEY=
